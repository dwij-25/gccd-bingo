# ==========================================
# GCCD BINGO - ENVIRONMENT CONFIGURATION
# ==========================================

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:3000

# EMBED & CORS ALLOWED ORIGINS (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://gccd.gdg.community,https://mycommunitywebsite.com

# SECURITY & AUTH
JWT_SECRET=super_secret_production_jwt_key_at_least_32_characters_long_gccd_2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=secure_session_cookie_secret_key_gccd_2026

# OPTIONAL ONE-TIME PASSCODE (OTP) EMAIL LOGIN
ENABLE_EMAIL_OTP=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=events@gdg.community
SMTP_PASS=app_password_here
EMAIL_FROM="GCCD Team <events@gdg.community>"

# DATABASE (PostgreSQL / Supabase connection string)
# Example: postgresql://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gccd_bingo
# For quick local testing without PostgreSQL, SQLite fallback is supported when DATABASE_URL is empty:
SQLITE_DB_PATH=./gccd_bingo.db

# IMAGE STORAGE PROVIDER (Choose: "supabase", "cloudinary", or "local")
STORAGE_PROVIDER=local

# SUPABASE STORAGE CONFIG (If STORAGE_PROVIDER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=bingo-images

# CLOUDINARY CONFIG (If STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=gccd-bingo-2026

# ADMIN ACCESS
ADMIN_SECRET_KEY=admin_gccd_secure_pass_2026
ADMIN_EMAIL=organizer@gdg.community

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
