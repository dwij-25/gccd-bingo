{
  "name": "gccd-bingo-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Photo Bingo Web Application for Google Cloud Developer Group Community Day (GCCD)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:api": "npm --workspace=apps/api run dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:web": "npm --workspace=apps/web run build",
    "build:api": "npm --workspace=apps/api run build",
    "build": "npm run build:api && npm run build:web",
    "lint": "npm --workspaces run lint",
    "test": "npm --workspaces run test",
    "import:participants": "npm --workspace=apps/api run import:participants"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.3",
    "vercel": "^65.9.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  }
}
